# Documentation template only. For a NEW install use:
#   python3 scripts/configure_env.py --init
# Existing deployments: preserve .env and volumes; follow SECURITY.md.
# Blank required secrets make Compose fail closed; never commit real values.
HF_TOKEN=
VLLM_API_KEY=
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=
REDIS_AUTH=
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_PASSWORD=

# Registrations are closed except during supervised, loopback-only bootstrap.
ENABLE_SIGNUP=false
AUTH_DISABLE_SIGNUP=true
NEXTAUTH_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://langfuse-web:3000/api/public/otel/v1/traces
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
