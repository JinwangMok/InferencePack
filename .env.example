# InferencePack Environment Configuration
# Copy this file to .env and fill in your values

# HuggingFace Token (required for gated/private models)
HF_TOKEN=your_huggingface_token_here

# vLLM API Key (optional - enables API authentication)
VLLM_API_KEY=your_vllm_api_key_here

# LangFuse Security Keys
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars-long
SALT=your-salt-min-32-chars-long
ENCRYPTION_KEY=your-64-char-hex-encryption-key
REDIS_AUTH=your-redis-password

# LangFuse Initial User (auto-created on first run)
LANGFUSE_INIT_USER_EMAIL=netai@smartx.kr
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=netai123

# LangFuse API Keys (get these from LangFuse UI after first startup)
LANGFUSE_PUBLIC_KEY=pk-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-xxxxxxxx

# OpenTelemetry Endpoint for sending traces to LangFuse
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://langfuse-web:3000/api/public/otel/v1/traces

# Backend URL (set automatically by run.sh based on engine selection)
BACKEND_URL=http://vllm:8000
ENABLE_LANGFUSE=true
